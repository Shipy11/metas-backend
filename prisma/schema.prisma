// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  USER
  ADMIN
}

model Account {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  passwordHash String
  phoneNumber  String?
  role         AccountRole @default(USER)

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companiesCreated        Company[]         @relation("CompanyCreatedBy")
  companiesUpdated        Company[]         @relation("CompanyUpdatedBy")
  financialRecordsCreated FinancialRecord[] @relation("FinancialRecordCreatedBy")
  financialRecordsUpdated FinancialRecord[] @relation("FinancialRecordUpdatedBy")
  companyMemberships      CompanyMember[]

  offersCreated PartnershipOffer[] @relation("PartnershipOfferCreatedBy")
  offersUpdated PartnershipOffer[] @relation("PartnershipOfferUpdatedBy")

  proposalsCreated  InvestmentProposal[] @relation("InvestmentProposalCreatedBy")
  proposalsReviewed InvestmentProposal[] @relation("InvestmentProposalReviewedBy")
}

model Company {
  id          Int     @id @default(autoincrement())
  name        String
  legalName   String?
  email       String  @unique
  phoneNumber String  @unique

  description        String?
  industry           String?
  businessType       String?
  productsOrServices String?
  foundedYear        Int?
  websiteUrl         String?
  logoUrl            String?

  address   String?
  city      String?
  state     String?
  country   String?
  gstNumber String? @unique

  isActive Boolean @default(true)

  createdById     Int
  lastUpdatedById Int?

  createdBy        Account           @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  lastUpdatedBy    Account?          @relation("CompanyUpdatedBy", fields: [lastUpdatedById], references: [id])
  financialRecords FinancialRecord[]
  members          CompanyMember[]

  partnershipOffers PartnershipOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investmentProposals InvestmentProposal[]
}

enum CompanyRole {
  OWNER
  PARTNER
}

model CompanyMember {
  id        Int @id @default(autoincrement())
  accountId Int
  companyId Int

  role CompanyRole

  ownershipPercentage Decimal @default(0) @db.Decimal(5, 2)

  isActive Boolean @default(true)

  account Account @relation(fields: [accountId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, companyId])
}

model FinancialRecord {
  id        Int @id @default(autoincrement())
  companyId Int

  periodStart DateTime
  periodEnd   DateTime

  revenue          Decimal  @db.Decimal(15, 2)
  expenses         Decimal  @db.Decimal(15, 2)
  companyValuation Decimal? @db.Decimal(15, 2)

  totalDebt   Decimal  @default(0) @db.Decimal(15, 2)
  totalAssets Decimal? @db.Decimal(15, 2)
  cashBalance Decimal? @db.Decimal(15, 2)

  createdById     Int
  lastUpdatedById Int?

  company       Company  @relation(fields: [companyId], references: [id])
  createdBy     Account  @relation("FinancialRecordCreatedBy", fields: [createdById], references: [id])
  lastUpdatedBy Account? @relation("FinancialRecordUpdatedBy", fields: [lastUpdatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EquityOfferType {
  NEW_EQUITY
  STAKE_TRANSFER
}

enum PartnershipOfferStatus {
  OPEN
  PARTIALLY_FUNDED
  FUNDED
  CLOSED
  CANCELLED
}

model PartnershipOffer {
  id Int @id @default(autoincrement())

  companyId Int

  title       String
  description String?

  fundingGoal      Decimal @db.Decimal(15, 2)
  fundingRaised    Decimal @default(0) @db.Decimal(15, 2)
  equityPercentage Decimal @db.Decimal(5, 2)
  equityCommitted  Decimal @default(0) @db.Decimal(5, 2)

  minimumInvestment Decimal? @db.Decimal(15, 2)

  purpose String?

  offerType EquityOfferType

  status PartnershipOfferStatus @default(OPEN)

  expiresAt DateTime?

  createdById     Int
  lastUpdatedById Int?

  company       Company  @relation(fields: [companyId], references: [id])
  createdBy     Account  @relation("PartnershipOfferCreatedBy", fields: [createdById], references: [id])
  lastUpdatedBy Account? @relation("PartnershipOfferUpdatedBy", fields: [lastUpdatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investmentProposals InvestmentProposal[]

  @@index([companyId])
}

enum InvestmentProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model InvestmentProposal {
  id Int @id @default(autoincrement())

  companyId Int
  offerId   Int

  createdById Int

  investmentAmount Decimal @db.Decimal(15, 2)
  requestedEquity  Decimal @db.Decimal(5, 2)

  message String?

  status InvestmentProposalStatus @default(PENDING)

  reviewedById Int?
  reviewedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id])

  offer PartnershipOffer @relation(fields: [offerId], references: [id])

  createdBy Account @relation("InvestmentProposalCreatedBy", fields: [createdById], references: [id])

  reviewedBy Account? @relation("InvestmentProposalReviewedBy", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offerId, createdById])
  @@index([companyId])
  @@index([offerId])
  @@index([createdById])
  @@index([status])
}
